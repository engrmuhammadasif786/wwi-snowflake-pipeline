# ==============================================================================
# Wide World Importers (WWI) -> Azure Data Lake -> Snowflake Pipeline Config
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Pipeline Execution Mode
# Set DRY_RUN_LOCAL=true to run the entire pipeline locally (Parquet + DuckDB/local exports)
# without requiring live Azure or Snowflake accounts (ideal for peer review & CI testing).
# Set DRY_RUN_LOCAL=false to execute against live Azure ADLS Gen2 and Snowflake.
# ------------------------------------------------------------------------------
DRY_RUN_LOCAL=true

# ------------------------------------------------------------------------------
# WWI Dataset Source Configuration
# Primary public base URL for WWI sample tables; pipeline automatically falls back
# to deterministic local WWI dataset generation if the remote URL is unreachable.
# ------------------------------------------------------------------------------
WWI_SOURCE_BASE_URL=https://raw.githubusercontent.com/microsoft/sql-server-samples/master/samples/databases/wide-world-importers
WWI_SAMPLE_START_DATE=2023-01-01
WWI_SAMPLE_END_DATE=2025-12-31
WWI_SAMPLE_ORDER_COUNT=5000
WWI_RANDOM_SEED=42
LOCAL_DATA_DIR=./data

# ------------------------------------------------------------------------------
# Azure Data Lake Storage Gen2 (ADLS) / Blob Storage Configuration
# ------------------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=rg-wwi-analytics-dev
AZURE_LOCATION=eastus
AZURE_STORAGE_ACCOUNT_NAME=stwwidatalakedev01
AZURE_STORAGE_ACCOUNT_KEY=your_azure_storage_account_key_here
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_RAW=wwi-raw
AZURE_CONTAINER_STAGING=wwi-staging
AZURE_RAW_PREFIX=wwi/v1

# ------------------------------------------------------------------------------
# Snowflake Data Warehouse Configuration
# ------------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=xy12345.east-us-2.azure
SNOWFLAKE_USER=WWI_PIPELINE_USER
SNOWFLAKE_PASSWORD=your_snowflake_password_here
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=WWI_WH
SNOWFLAKE_DATABASE=WWI_DB
SNOWFLAKE_SCHEMA_RAW=RAW
SNOWFLAKE_SCHEMA_STAGING=STAGING
SNOWFLAKE_SCHEMA_MARTS=MARTS
SNOWFLAKE_STORAGE_INTEGRATION=AZURE_WWI_INTEGRATION
SNOWFLAKE_EXTERNAL_STAGE=WWI_AZURE_RAW_STAGE

# ------------------------------------------------------------------------------
# Dagster Configuration
# ------------------------------------------------------------------------------
DAGSTER_HOME=/opt/dagster/dagster_home
DAGSTER_PORT=3000
