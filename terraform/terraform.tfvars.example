# Copy to terraform.tfvars and populate with your credentials:
#   cp terraform.tfvars.example terraform.tfvars

azure_subscription_id        = "00000000-0000-0000-0000-000000000000"
azure_tenant_id              = "00000000-0000-0000-0000-000000000000"
azure_resource_group_name    = "rg-wwi-analytics-dev"
azure_location               = "East US"
azure_storage_account_name   = "stwwidatalakedev01"
azure_raw_container_name     = "wwi-raw"
azure_staging_container_name = "wwi-staging"
environment                  = "dev"

snowflake_account            = "xy12345.east-us-2.azure"
snowflake_user               = "WWI_PIPELINE_USER"
snowflake_password           = "replace_with_snowflake_password"
snowflake_role               = "ACCOUNTADMIN"
snowflake_warehouse_name     = "WWI_WH"
snowflake_warehouse_size     = "X-SMALL"
snowflake_database_name      = "WWI_DB"
